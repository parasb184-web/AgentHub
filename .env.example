# Copy this file to .env.local and fill in real values.
#
#   cp .env.example .env.local
#
# The app runs without any of these — it falls back to demo mode, where the
# agent catalog, filters, search, and sandbox previews all work from local
# data. Fill these in to enable sign-in, publishing, and live execution.

# ---------------------------------------------------------------------------
# Firebase — required for sign-in, /dashboard, /publish, and API key issuance.
# These are NEXT_PUBLIC_*, so they are exposed to the browser. That is expected
# for Firebase web config; access is controlled by firestore.rules, not secrecy.
# Get them from Firebase console > Project settings > Your apps > Web app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Server-side secrets — never prefix these with NEXT_PUBLIC_.
# In production keep them in Secret Manager, not in plain environment config.
# ---------------------------------------------------------------------------

# Repo scan analysis and search reasoning. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# AI news digest at /api/ai-news. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Raises the GitHub API limit for /scan from 60 to 5000 requests/hour.
# A classic token with public_repo scope is enough.
GITHUB_TOKEN=

# Semantic search and gap detection. https://console.upstash.com/vector
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Sandbox rate limiting. https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
