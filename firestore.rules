rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // These rules govern browser (client SDK) access only.
    // API routes use the Firebase Admin SDK, which authenticates as a service
    // account and bypasses rules entirely - so anything written only by the
    // server is denied here on purpose.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /agents/{agentId} {
      allow read: if true; // Public marketplace
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.creatorId);
    }

    match /agent_reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /agent_calls/{callId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false; // Written by the sandbox route via Admin SDK
    }

    match /activity_feed/{feedId} {
      allow read: if true;
      allow write: if false; // Seeded by the server via Admin SDK
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /api_keys/{keyId} {
      // Keys are issued, listed and revoked through /api/keys via Admin SDK.
      // The browser never needs direct access, and must never read a hash.
      allow read, write: if false;
    }

    match /chains/{chainId} {
      allow read: if true; // Shareable workflows
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /repo_scans/{scanId} {
      allow read: if true; // Public scan results
      allow write: if false; // Written by /api/github-scan via Admin SDK
    }

    match /repo_stacks/{stackId} {
      allow read: if true; // Backs the public /stack pages and badges
      allow write: if false; // Written by the server via Admin SDK
    }

    match /copyright_claims/{claimId} {
      allow read: if false; // Moderation queue - not publicly readable
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Server-side response caches. Never touched by the browser.
    match /claude_cache/{docId} {
      allow read, write: if false;
    }

    match /gemini_cache/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false; // Default deny all
    }
  }
}
